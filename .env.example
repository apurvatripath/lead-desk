# Documentation only: the app reads process environment, not this file.
# Keep credentials in your deployment's secret store, never in project files.
LEAD_DESK_MODE=synthetic
# Required on startup. Keep the generated secret in the process environment.
# Use Authorization: Bearer <secret> on webhook, lead, and scorecard routes.
LEAD_DESK_API_KEY=
LEAD_DESK_SCORER_PROVIDER=gemini
LEAD_DESK_GEMINI_API_KEY=
LEAD_DESK_GEMINI_MODEL=gemini-3.6-flash
LEAD_DESK_OWNERS=alice@agency.com,bob@agency.com
LEAD_DESK_CRM_MODE=dry_run
# For a real HubSpot write, use LEAD_DESK_CRM_MODE=hubspot with a Private App token
LEAD_DESK_HUBSPOT_TOKEN=
ALERT_MODE=dry_run
# For a real Slack/Discord alert, use ALERT_MODE=webhook with an incoming-webhook URL
ALERT_WEBHOOK_URL=
LEAD_DESK_AUTOREPLY_MODE=dry_run
# For a real auto-reply email, use LEAD_DESK_AUTOREPLY_MODE=resend
LEAD_DESK_RESEND_API_KEY=
LEAD_DESK_FROM_EMAIL=
LEAD_DESK_DATABASE_PATH=data/lead_desk.sqlite3
